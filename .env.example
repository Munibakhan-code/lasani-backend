# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Mongo
MONGO_URI=mongodb://127.0.0.1:27017/restaurant

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=change-me-cookie
COOKIE_DOMAIN=localhost

# CORS (comma separated)
CORS_WHITELIST=http://localhost:3000,http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=restaurant

# Email
EMAIL_PROVIDER=smtp
EMAIL_FROM="Restaurant <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Frontend
FRONTEND_URL=http://localhost:5173

# Redis (optional, ready)
REDIS_URL=redis://127.0.0.1:6379